<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The game world + 750MB asset pipeline exceed the default WKWebView
	     content-process jetsam budget on iPhones. This raises the app's memory
	     limit on supported devices (public entitlement, App Store allowed). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
