# Auto-detect text files and normalize line endings to LF
* text=auto

# Enforce strict LF for shell scripts and source code across all operating systems
*.sh text eol=lf
*.bash text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.xml text eol=lf
